# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token
TAILNET_NAME=your_tailnet_name

# Tailscale API Configuration
TAILSCALE_API_TOKEN=your_tailscale_api_token

# Discord OAuth Configuration
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:5000/auth/callback

# Web Server Configuration
FLASK_SECRET_KEY=generate_a_random_secret_key
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=false

# Access Control
ALLOWED_DISCORD_IDS=comma,separated,discord,user,ids
NOTIFICATION_CHANNEL_ID=your_discord_channel_id

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000 